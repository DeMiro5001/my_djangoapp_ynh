# .env template
# Django
SECRET_KEY=__SECRET_KEY__
DEBUG=False
ALLOWED_HOSTS=__DOMAIN__,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS='https://__DOMAIN__'

# Database engine: sqlite3 or postgresql
DB_ENGINE=__DB_ENGINE__
DB_NAME=__DB_NAME__
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PWD__
DB_HOST=localhost
DB_PORT=5432

# Redis/Celery
# Django cache via redis
REDIS_URL=redis://localhost:6379/__REDIS_DB__
# Celery message queue
CELERY_BROKER_URL=redis://localhost:6379/__CELERY_BROKER_DB__
# Celery task results
CELERY_RESULT_BACKEND=redis://localhost:6379/__CELERY_RESULT_DB__

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=__DOMAIN__
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=__MAIL_USER__
DEFAULT_FROM_EMAIL=__MAIL_USER__@__DOMAIN__
EMAIL_HOST_PASSWORD=__MAIL_PWD__

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Static files
STATIC_ROOT=__INSTALL_DIR__/staticfiles
MEDIA_ROOT=__DATA_DIR__/media
DATA_DIR=__DATA_DIR__
